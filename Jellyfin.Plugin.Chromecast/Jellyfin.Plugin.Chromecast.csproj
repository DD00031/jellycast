<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <RootNamespace>Jellyfin.Plugin.Chromecast</RootNamespace>
    <AssemblyName>Jellyfin.Plugin.Chromecast</AssemblyName>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <!--
      Jellyfin's plugin loader recursively loads every .dll under the plugin folder, including
      RID-specific "runtimes/**" assets - it has no RID-aware resolution like a normal apphost.
      A transitive dependency (via SharpCaster -> System.Text.Json) ships a browser/WASM-targeted
      System.Text.Encodings.Web.dll under runtimes/browser/lib/net8.0, which conflicts with the
      copy already loaded by the host and disables the whole plugin. Disabling copy of these
      RID-specific assets keeps only the generic managed assembly, which is all a
      framework-dependent, in-process plugin needs.
    -->
    <CopyLocalRuntimeTargetAssets>false</CopyLocalRuntimeTargetAssets>
  </PropertyGroup>

  <!--
    Jellyfin's MediaBrowser.Controller/Model assemblies get a new AssemblyVersion on every patch
    release (confirmed by testing: a plugin built against 10.11.11 fails outright against a
    10.11.6 server with "Could not load file or assembly ... Version=10.11.11.0 ... The system
    cannot find the file specified", even though the interface source is identical). There is no
    way to make one compiled build tolerant of that at runtime - the required version is baked
    into the plugin DLL's own metadata. JellyfinServerVersion lets you rebuild against a specific
    server version without hand-editing this file, e.g.:
      dotnet build -p:JellyfinServerVersion=10.11.6 Jellyfin.Plugin.Chromecast.csproj
    Defaults to the version this repository currently targets.
  -->
  <PropertyGroup>
    <JellyfinServerVersion Condition="'$(JellyfinServerVersion)' == ''">10.11.11</JellyfinServerVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Jellyfin.Controller" Version="$(JellyfinServerVersion)">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Jellyfin.Model" Version="$(JellyfinServerVersion)">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- CastV2 protocol, mDNS discovery and media control for Google Cast devices. -->
    <ProjectReference Include="..\SharpCaster\Sharpcaster\Sharpcaster.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Configuration\configPage.html" />
    <EmbeddedResource Include="Configuration\configPage.html" />
  </ItemGroup>

  <!--
    Jellyfin's plugin loader gives each plugin its own isolated AssemblyLoadContext and, before
    activating it, calls assembly.GetTypes() to eagerly resolve every member signature - including
    ISessionController/IPluginServiceRegistrator method parameters typed as IServiceCollection and
    ILogger<T>. SharpCaster pulls in Microsoft.Extensions.DependencyInjection(.Abstractions) and
    Microsoft.Extensions.Logging.Abstractions transitively, and if copies of those ship alongside
    the plugin, the isolated load context resolves our copy instead of the host's - a different
    assembly identity for the "same" type - which fails GetTypes() with a TypeLoadException
    ("Method 'RegisterServices' ... does not have an implementation") and gets the whole plugin
    disabled. Jellyfin's own host is built on these same Microsoft.Extensions.* packages and
    always provides them, so strip our copies after publish and let the plugin load context fall
    through to the host's.
  -->
  <Target Name="RemoveHostProvidedAssemblies" AfterTargets="Publish">
    <ItemGroup>
      <_HostProvidedAssembly Include="$(PublishDir)Microsoft.Extensions.DependencyInjection.dll" />
      <_HostProvidedAssembly Include="$(PublishDir)Microsoft.Extensions.DependencyInjection.Abstractions.dll" />
      <_HostProvidedAssembly Include="$(PublishDir)Microsoft.Extensions.Logging.Abstractions.dll" />
    </ItemGroup>
    <Delete Files="@(_HostProvidedAssembly)" Condition="Exists('%(_HostProvidedAssembly.Identity)')" />
  </Target>

</Project>
